# Tạo trong thư mục gốc của dự án (D:\Downloads\Test)
New-Item -Path ".dockerignore" -ItemType File -Force
Set-Content -Path ".dockerignore" -Value @"
# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Data files (large)
*.csv
*.parquet
*.pkl
*.onnx
*.json

# Logs
*.log
logs/

# Virtual environment
venv/
env/
.venv/

# Node modules (nếu có)
node_modules/
"@